{
  "name": "rotative-levitator",
  "version": "1.0.0",
  "description": "Palindromic sonnets by Pedro Poitevin \u2014 a bilingual reading edition",
  "keywords": [
    "poetry",
    "palindromes",
    "sonnets",
    "interactive"
  ],
  "main": "reader/sonnets.mjs",
  "homepage": "https://poitevin.github.io/rotative-levitator",
  "dependencies": {
    "lucide-react": "0.454.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-scripts": "^5.0.0"
  },
  "devDependencies": {
    "gh-pages": "^5.0.0"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/sonnets.test.mjs",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "legacy:start": "react-scripts start",
    "legacy:build": "react-scripts build",
    "legacy:test": "react-scripts test --env=jsdom"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
